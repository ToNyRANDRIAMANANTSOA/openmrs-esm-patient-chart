{
  "name": "@openmrs/esm-patient-print-app",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "description": "patient-print-app frontend module for O3",
  "browser": "dist/openmrs-esm-patient-print-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "debug": "npm run serve",
    "build": "rspack --mode=production",
    "build:development": "rspack --mode development",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "cross-env eslint src --ext tsx,ts --fix --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typescript": "tsc",
    "extract-translations": "i18next 'src/**/*.component.tsx' 'src/**/*.modal.tsx' 'src/**/*.extension.tsx' 'src/**/*.workspace.tsx' 'src/**/*.hook.tsx' 'src/**/*.resource.ts' 'src/index.ts' --config ../../tools/i18next-parser.config.js"
  },
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-patient-print-app.git"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-patient-print-app/issues"
  },
  "homepage": "https://github.com/openmrs/openmrs-esm-patient-print-app#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@carbon/react": "^1.83.0"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "*",
    "dayjs": "1.x",
    "i18next": "25.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-is": "18.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "sass": "1.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "openmrs": "next",
    "vitest": "^4.1.2"
  }
}
